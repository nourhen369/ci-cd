# Copy this file to `terraform/.env` and fill with your real values.
# Keep the file out of version control. Example uses the `TF_VAR_` prefix
# so Terraform picks them up automatically as input variables.
TF_VAR_subscription_id="your-subscription-id"
TF_VAR_client_id="your-client-id"
TF_VAR_client_secret="your-client-secret"
TF_VAR_tenant_id="your-tenant-id"


# Then you can set these variables in your shell environment to use them later
# export $(grep -v '^#' terraform/.env | xargs)